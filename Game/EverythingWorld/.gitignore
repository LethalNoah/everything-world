# Unity project ignore rules. Paths are relative to this folder (Game/EverythingWorld).
# Unity rebuilds everything listed here on its own, so none of it belongs in Git.

# Cache and scratch folders Unity regenerates (Library alone is ~2 GB)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Builds of the game
/[Bb]uild/
/[Bb]uilds/

# Asset Store tools
/[Aa]ssets/AssetStoreTools*

# Visual Studio / Rider / VS Code files Unity generates
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and profiler captures
sysinfo.txt
crashlytics-buildid.txt
*.apk
*.aab
*.unitypackage
*.app

# Gradle / Android leftovers
.gradle/
/[Aa]ssets/Plugins/Android/gradle-wrapper.jar

# Addressables build output
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Secrets: Spotify app settings and saved login tokens (never commit)
/[Aa]ssets/[Ss]treamingAssets/spotify_config.json
/[Aa]ssets/[Ss]treamingAssets/spotify_config.json.meta
spotify_tokens.json

# Asset Store and other third-party content stays on this computer: the repo is public, and store
# licences don't allow sharing what you bought (it would also use up Git LFS storage).
# So Git ignores everything directly in Assets/ and Packages/ EXCEPT the project's own items below.
# New project files go under Assets/_Project/; anything imported elsewhere is ignored automatically.
# To track a new top-level item on purpose, add a "!" line for it (and for its .meta file).
/[Aa]ssets/*
!/Assets/_Project/
!/Assets/_Project.meta
!/Assets/Scenes/
!/Assets/Scenes.meta
!/Assets/Settings/
!/Assets/Settings.meta
!/Assets/StreamingAssets/
!/Assets/StreamingAssets.meta
!/Assets/TutorialInfo/
!/Assets/TutorialInfo.meta
!/Assets/InputSystem_Actions.inputactions
!/Assets/InputSystem_Actions.inputactions.meta
!/Assets/Readme.asset
!/Assets/Readme.asset.meta
# Packages/: only the package list is ours; embedded packages (Lumen, Opsive...) come from the store
/[Pp]ackages/*/
