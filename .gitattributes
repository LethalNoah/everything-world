# Git LFS rules: big binary files inside the Unity project are stored with Git LFS.
# Only Game/ is covered. The GitHub Pages site (index.html, assets/, map_poster.png)
# must stay plain Git, because GitHub Pages can't serve LFS files.

# 3D models
Game/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Game/**/*.FBX filter=lfs diff=lfs merge=lfs -text
Game/**/*.obj filter=lfs diff=lfs merge=lfs -text
Game/**/*.blend filter=lfs diff=lfs merge=lfs -text
Game/**/*.glb filter=lfs diff=lfs merge=lfs -text
Game/**/*.gltf filter=lfs diff=lfs merge=lfs -text
Game/**/*.dae filter=lfs diff=lfs merge=lfs -text
Game/**/*.bytes filter=lfs diff=lfs merge=lfs -text
Game/**/*.3ds filter=lfs diff=lfs merge=lfs -text
Game/**/*.max filter=lfs diff=lfs merge=lfs -text
Game/**/*.ma filter=lfs diff=lfs merge=lfs -text
Game/**/*.mb filter=lfs diff=lfs merge=lfs -text
Game/**/*.vox filter=lfs diff=lfs merge=lfs -text

# Textures and images
Game/**/*.png filter=lfs diff=lfs merge=lfs -text
Game/**/*.PNG filter=lfs diff=lfs merge=lfs -text
Game/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Game/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
Game/**/*.JPG filter=lfs diff=lfs merge=lfs -text
Game/**/*.psd filter=lfs diff=lfs merge=lfs -text
Game/**/*.tga filter=lfs diff=lfs merge=lfs -text
Game/**/*.tif filter=lfs diff=lfs merge=lfs -text
Game/**/*.tiff filter=lfs diff=lfs merge=lfs -text
Game/**/*.exr filter=lfs diff=lfs merge=lfs -text
Game/**/*.hdr filter=lfs diff=lfs merge=lfs -text
Game/**/*.gif filter=lfs diff=lfs merge=lfs -text
Game/**/*.bmp filter=lfs diff=lfs merge=lfs -text
Game/**/*.kra filter=lfs diff=lfs merge=lfs -text

# Audio and video
Game/**/*.wav filter=lfs diff=lfs merge=lfs -text
Game/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
Game/**/*.ogg filter=lfs diff=lfs merge=lfs -text
Game/**/*.aif filter=lfs diff=lfs merge=lfs -text
Game/**/*.aiff filter=lfs diff=lfs merge=lfs -text
Game/**/*.flac filter=lfs diff=lfs merge=lfs -text
Game/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
Game/**/*.mov filter=lfs diff=lfs merge=lfs -text

# Fonts and other binaries
Game/**/*.ttf filter=lfs diff=lfs merge=lfs -text
Game/**/*.otf filter=lfs diff=lfs merge=lfs -text
Game/**/*.dll filter=lfs diff=lfs merge=lfs -text
Game/**/*.so filter=lfs diff=lfs merge=lfs -text
Game/**/*.a filter=lfs diff=lfs merge=lfs -text
Game/**/*.zip filter=lfs diff=lfs merge=lfs -text
Game/**/*.cubemap filter=lfs diff=lfs merge=lfs -text
Game/**/*.unitypackage filter=lfs diff=lfs merge=lfs -text

# Unity's text files (scenes, prefabs, settings) stay plain Git with LF line endings,
# so diffs don't fill up with Windows/Unix line-ending noise.
Game/**/*.unity text eol=lf
Game/**/*.prefab text eol=lf
Game/**/*.asset text eol=lf
Game/**/*.mat text eol=lf
Game/**/*.meta text eol=lf
Game/**/*.anim text eol=lf
Game/**/*.controller text eol=lf
Game/**/*.physicMaterial text eol=lf
Game/**/*.inputactions text eol=lf
Game/**/*.cs text eol=lf
Game/**/*.shader text eol=lf
Game/**/*.hlsl text eol=lf
Game/**/*.shadergraph text eol=lf
Game/**/*.json text eol=lf
